{
	"name": "@isopodlabs/tison",
	"version": "0.1.0",
	"description": "Typescript bison.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/adrianstephens/ts-bison.git"
	},
	"main": "dist/tison.js",
	"bin": {
		"tsw": "dist/examples/TS/tsw.js"
	},
	"files": [
		"dist/**/*.{js,d.ts}",
		"README.md"
	],
	"scripts": {
		"build": "tsc",
		"watch": "tsc -watch -p ./",
		"examples": "tsc -b examples",
		"postexamples": "cp -r examples/TS/lib dist/examples/TS/lib && node -e \"const f='dist/examples/TS/tsw.js',fs=require('fs'),c=fs.readFileSync(f,'utf8');if(!c.startsWith('#!'))fs.writeFileSync(f,'#!/usr/bin/env node\\n'+c);fs.chmodSync(f,0o755);\"",
		"lint": "eslint \"src/**/*.ts\"",
		"link": "npm link @isopodlabs/binary_libs"
	},
	"keywords": [
		"typescript",
		"string",
		"iterator",
		"algorithm"
	],
	"author": "Adrian Stephens",
	"license": "MIT",
	"dependencies": {
		"@isopodlabs/binary_libs": "^1.10.0"
	}
}
