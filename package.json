{
	"name": "@isopodlabs/tison",
	"version": "0.1.0",
	"description": "Typescript bison.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/adrianstephens/ts-bison.git"
	},
	"main": "dist/tison.js",
	"bin": {
		"tsw": "dist/examples/TS/tsw.js"
	},
	"files": [
		"dist/**/*.{js,d.ts}",
		"README.md"
	],
	"scripts": {
		"build": "npm run copylib && tsc && npm run examples",
		"build:emit": "tsc; npm run examples; npm run copylib",
		"watch": "tsc -watch -p ./",
		"examples": "tsc -b src/examples",
		"postexamples": "npm run copylib && node -e \"const f='dist/examples/TS/tsw.js',fs=require('fs'),c=fs.readFileSync(f,'utf8');if(!c.startsWith('#!'))fs.writeFileSync(f,'#!/usr/bin/env node\\n'+c);fs.chmodSync(f,0o755);\"",
		"copylib": "rm -rf dist/examples/TS/lib && cp -r src/examples/TS/lib dist/examples/TS/lib",
		"lint": "eslint \"src/**/*.ts\"",
		"link": "npm link @isopodlabs/binary_libs",
		"gate": "npm run build:emit && ts-node -T test/test-ts-corpus-gate.ts",
		"checker": "npm run build:emit && ts-node -T test/test-checker.ts",
		"libdecls": "npm run build:emit && ts-node -T test/test-lib-decls.ts",
		"libdecls:update": "npm run build:emit && ts-node -T test/test-lib-decls.ts --update",
		"gate:list": "ts-node -T test/test-ts-corpus-gate.ts --list",
		"gate:update": "ts-node -T test/test-ts-corpus-gate.ts --update"
	},
	"keywords": [
		"typescript",
		"string",
		"iterator",
		"algorithm"
	],
	"author": "Adrian Stephens",
	"license": "MIT",
	"dependencies": {
		"@isopodlabs/binary_libs": "^1.10.0"
	}
}
